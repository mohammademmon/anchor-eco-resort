# Public site URL (used for canonical URLs, metadata, redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string (Drizzle) — Supabase pooled connection
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Resend (transactional email)
RESEND_API_KEY=your-resend-api-key

# Secret shared with scheduled cron jobs
CRON_SECRET=change-me

# WhatsApp contact number (no + prefix)
NEXT_PUBLIC_WHATSAPP=8801897629200
